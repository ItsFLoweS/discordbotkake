{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBK", "version": "0.1.0", "identifier": "com.itsflowes.dbk",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "DBK · By ItsFloweS", "width": 1440, "height": 900, "minWidth": 1040, "minHeight": 680, "backgroundColor": "#141617" }], "security": { "csp": "default-src 'self'; img-src 'self' data: blob: https://cdn.discordapp.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["nsis"], "publisher": "ItsFloweS", "icon": ["icons/icon.ico", "icons/icon.png"], "shortDescription": "Визуальный конструктор Discord-ботов", "resources": ["resources/runtime/**/*", "resources/node.exe"], "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["Russian", "English"], "installMode": "currentUser" } } }
}
